# Docker 部署可调参数：复制为 .env 后按需修改（docker compose 自动读取）
# MySQL root 密码（首启建库后修改需同步改已有卷，建议首启前定好）
MYSQL_ROOT_PASSWORD=xinfei123456
# 对外端口
APP_PORT=8080
# 对外访问地址（生成堂食二维码等链接用）：手机扫码请填宿主机局域网 IP
XINFEI_SERVER_URL=http://localhost:8080
# JVM 参数（默认 -Xms512m -Xmx1024m -Duser.timezone=Asia/Shanghai，容器内存够时可上调堆大小）
# JAVA_OPTS=-Xms1g -Xmx2g -Duser.timezone=Asia/Shanghai

# —— 接真实微信 / 支付宝收款时，取消注释并改为 false ——
# 变量名请用下方写法（属性名里的连字符换成下划线）：Spring 只把 '.' 与 '-' 映射成 '_'，
# 写成 XINFEI_PAYMENT_MOCKMODE 这类丢掉连字符的名字，应用读不到，会静默沿用 profile 配置值。
# 关闭模拟支付（走真实渠道验签）并移除 prod 豁免；同时需在后台「支付渠道配置」填写并启用渠道凭据
# XINFEI_PAYMENT_MOCK_MODE=false
# ALLOW_MOCK_IN_PROD=false
# 短信 / 推送 / 第三方配送同理（默认 mock 仅打日志不外呼）
# XINFEI_SMS_MOCK_MODE=false
# XINFEI_PUSH_MOCK_MODE=false
# XINFEI_DELIVERY_MOCK_MODE=false

# —— 数据库结构迁移（Flyway）——
# 默认 true：首次 up 是空库，由应用建表 + 写最小种子（admin/123456）。
# 已有库只会记一条基线行，不重放 V1/V2、不动业务数据。
# 对公网提供服务的部署请改为 false，结构变更走人工评审 + 手动执行（见 docs/FLYWAY_MIGRATION.md）。
# FLYWAY_ENABLED=false
