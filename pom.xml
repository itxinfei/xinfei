<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.xinfei</groupId>
    <artifactId>xinfei_take_out</artifactId>
    <version>1.0-SNAPSHOT</version>
    <description>心飞外卖</description>

    <properties>
        <java.version>25</java.version>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!--阿里云短信服务-->
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>aliyun-java-sdk-core</artifactId>
            <version>4.5.16</version>
        </dependency>

        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>aliyun-java-sdk-dysmsapi</artifactId>
            <version>2.1.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Boot 4 模块化：@WebMvcTest / @AutoConfigureMockMvc 从 starter-test 拆出，需显式引入 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Boot 4 模块化：TestRestTemplate（spring-boot-resttestclient）依赖的
             ClientHttpRequestFactoryBuilder / RestTemplateBuilder 拆到
             spring-boot-http-client、spring-boot-restclient 两个模块且非传递，显式补上。
             主代码只用 spring-web 原生 RestTemplate，不需要这两个模块，故均为 test scope。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-http-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Redis 缓存支持 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Spring Session Redis：HttpSession 落 Redis，多副本部署共享登录态（R-01） -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
        </dependency>

        <!-- Apache Commons Pool2 (Redis 连接池依赖，Lettuce 连接池必需) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 配置加密 -->
        <dependency>
            <groupId>com.github.ulisesbocchio</groupId>
            <artifactId>jasypt-spring-boot-starter</artifactId>
            <version>4.0.4</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>3.5.17</version>
        </dependency>

        <!-- MP 3.5.9+ 拆分：租户插件等 JSqlParser 能力不再内置，须显式引入 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>3.5.17</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.48</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 连接池用 Boot 4 原生 HikariCP（经 spring-boot-starter-jdbc 传递引入）。
             Druid 已移除：druid-spring-boot-3-starter 直至 1.2.28 仍在字节码里引用 Boot 3 的
             org.springframework.boot.autoconfigure.jdbc.DataSourceProperties（Boot 4 已移至
             org.springframework.boot.jdbc.autoconfigure），@EnableConfigurationProperties
             解析失败导致上下文无法启动。本项目 Java 代码零 Druid 专有 API。 -->

        <!-- 数据库迁移：Flyway。Boot 4 已把 Flyway 自动配置从 spring-boot-autoconfigure 拆到
             独立模块 spring-boot-flyway —— 只引 flyway-core 时 spring.flyway.* 全部静默失效
             （迁移不执行、日志无输出、启动照样成功），必须显式引入本模块。
             版本由 BOM 管理（Boot 4.1.1 → Flyway 12.4.0）。
             基线语义见 application.yml 的 spring.flyway 与 docs/FLYWAY_MIGRATION.md -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <!-- Hutool 工具库 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>5.8.48</version>
        </dependency>

        <!-- Spring Security Crypto for BCrypt password encoding -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Spring Boot Actuator for monitoring -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Boot AspectJ AOP for aspects（Boot 4 将 starter-aop 更名为 starter-aspectj） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- 修改点：Spring Boot DevTools 开发热部署（常用开发组件，optional 避免传递依赖） -->
<!--        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>-->

        <!-- Swagger/OpenAPI 3（springdoc 3.x，适配 Boot 4 / Jakarta） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.1</version>
        </dependency>

        <!-- 二维码生成 -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.1</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.1</version>
        </dependency>

        <!-- 修改点：Apache POI - Excel文件读写 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>4.1.2</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>4.1.2</version>
        </dependency>

        <!-- 修改点：iText - PDF文件生成 -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itextpdf</artifactId>
            <version>5.5.13.3</version>
        </dependency>
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itext-asian</artifactId>
            <version>5.2.0</version>
        </dependency>
        <!-- Apache Commons Text for XSS escaping -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
            <version>1.10.0</version>
        </dependency>

        <!-- 微信支付官方 SDK（APIv3，支持 JDK 1.8+）：下单/查询/退款/回调验签与 AEAD 解密 -->
        <dependency>
            <groupId>com.github.wechatpay-apiv3</groupId>
            <artifactId>wechatpay-java</artifactId>
            <version>0.2.14</version>
        </dependency>

        <!-- 支付宝官方 SDK（RSA2，支持 JDK 1.6+）：电脑/手机网站/当面付/查询/退款/回调验签 -->
        <dependency>
            <groupId>com.alipay.sdk</groupId>
            <artifactId>alipay-sdk-java</artifactId>
            <version>4.39.79.ALL</version>
            <!-- commons-logging 与 spring-core 内置 spring-jcl 重复，排除后走 spring-jcl -->
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

</dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.48</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <!-- 复用 JVM（reuseForks=true）：配合 34 个测试类的 @DirtiesContext(AFTER_CLASS)
                         与 TestDatabaseCleaner.cleanTables（@BeforeEach 清表）实现数据隔离。
                         静态单例污染由 AFTER_CLASS 触发上下文重建解决，无需每类独立 JVM。
                         关键修复：reuseForks=false + JaCoCo agent 频繁 fork 会触发 surefire 2.22.2
                         的 "forked VM terminated without saying goodbye"（第二轮 fork 时 ClassNotFoundException），
                         导致全量测试 BUILD FAILURE（仅执行 271/414）。复用 JVM 后 JaCoCo agent
                         只加载一次，彻底消除 fork 崩溃。 -->
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                    <!-- 显式限定堆大小：64GB 大内存机器上 JVM 默认堆（ergonomics 约物理内存 1/4 ≈ 16GB）
                         难以连续分配，触发 "Could not reserve enough space for object heap" 致 fork 崩溃，
                         剩余测试类级联报错（曾出现 282 errors）。
                         -Xmx 历次调整：1024m 加载 15+ 模块 Spring 上下文即 GC overhead；
                         2048m 在基线 678 测试时临界；3072m 增至 789 测试后再次临界
                         （多个 @DirtiesContext 全量上下文在复用 JVM 内堆积，汇总输出后收尾阶段 OOM）；
                         提到 4096m 留出裕量，且在 16GB+ 空闲物理内存下可可靠连续分配。
                         @{argLine} 为 Maven 延迟属性解析，运行时注入 JaCoCo prepare-agent 设置的
                         javaagent，避免循环引用。 -->
                    <!-- -Dfile.encoding=UTF-8：强制测试 JVM 默认字符集为 UTF-8。
                         否则 Windows 中文系统默认 GBK，Spring 读取 @Sql 脚本（未显式指定 encoding 时
                         用平台默认字符集）会把 UTF-8 中文按 GBK 解析，导致"测试菜品/测试套餐"等
                         中文以乱码（娴嬭瘯鑿滃搧）入库。生产 Linux 默认即 UTF-8，测试对齐更真实。 -->
                    <argLine>@{argLine} -Xmx4096m -Xms512m -Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>4.1.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.4.1</version>
            </plugin>

            <!-- JaCoCo 测试覆盖率 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <configuration>
                    <output>file</output>
                    <append>true</append>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>




